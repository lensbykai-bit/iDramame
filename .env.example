# Telegram
BOT_TOKEN=
ADMIN_TELEGRAM_ID=

# Bakong KHQR receiver
BAKONG_ACCOUNT_ID=
BAKONG_MERCHANT_NAME=iDrama.me
BAKONG_MERCHANT_CITY=PHNOM PENH
BAKONG_MOBILE_NUMBER=

# Bakong Open API
BAKONG_API_BASE_URL=https://api-bakong.nbc.gov.kh
BAKONG_TOKEN=

# External iDrama.me Web Store
PUBLIC_BASE_URL=https://idramame.onrender.com

# Watch-link signing
# Optional but recommended: use a long random secret.
# If omitted, the app derives a signing key from BOT_TOKEN.
ACCESS_TOKEN_SECRET=

# Permanent story publishing from Telegram Admin
# Use a fine-grained GitHub token limited to lensbykai-bit/iDramame
# with Contents: Read and write. Never commit the real token.
GITHUB_TOKEN=
GITHUB_REPO=lensbykai-bit/iDramame
GITHUB_BRANCH=main

# Render sets PORT automatically in production
PORT=3000

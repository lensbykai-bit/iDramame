# Brand
BRAND_NAME=iDramaAi
PUBLIC_BASE_URL=https://idramaai.onrender.com

# Telegram bot + private media storage
BOT_TOKEN=
TELEGRAM_BOT_USERNAME=iDramaAi_bot
TELEGRAM_CHANNEL_ID=@your_channel_username
TELEGRAM_CHANNEL_URL=https://t.me/your_channel_username
ADMIN_TELEGRAM_ID=
TELEGRAM_STORAGE_CHAT_ID=

# ============================================================
# BAKONG KHQR — PRODUCTION PAYMENT CONFIGURATION
# Keep BAKONG_ACCOUNT_ID and BAKONG_TOKEN private in Render.
# Never commit real secret values to GitHub.
# ============================================================

# Your exact Bakong Account ID that receives the payment.
# Example format is the Bakong account ID shown by your bank/Bakong account.
BAKONG_ACCOUNT_ID=

# KHQR merchant display fields.
# Merchant name: max 25 chars in the KHQR SDK guideline.
# Merchant city: max 15 chars. PHNOM PENH is valid.
BAKONG_MERCHANT_NAME=iDramaAi
BAKONG_STORE_LABEL=iDramaAi
BAKONG_MERCHANT_CITY=PHNOM PENH

# Optional mobile number, international format without + (example: 855XXXXXXXXX).
BAKONG_MOBILE_NUMBER=

# Bakong Open API transaction verification.
BAKONG_API_BASE_URL=https://api-bakong.nbc.gov.kh

# Private Bakong Open API access token used by check_transaction_by_md5.
# Keep this only in Render Environment Variables.
# Bakong documentation states Open API tokens expire and must be renewed.
BAKONG_TOKEN=

# false = real Bakong payment
# true  = TEST MODE / no real charge; never use true in production.
BAKONG_TEST_MODE=false

# Security
# IMPORTANT: set this to a long random value in Render and do not change it,
# otherwise previously issued signed watch/checkout links can become invalid.
ACCESS_TOKEN_SECRET=

# Password for /admin.html
ADMIN_PASSWORD=

# Save story metadata from Web Admin to GitHub
GITHUB_TOKEN=
GITHUB_REPO=lensbykai-bit/iDramame
GITHUB_BRANCH=main

# Render sets PORT automatically
PORT=3000

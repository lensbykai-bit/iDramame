# Brand
BRAND_NAME=iDramaAi

# Telegram bot + public sales channel + Telegram-backed media storage
BOT_TOKEN=
TELEGRAM_BOT_USERNAME=iDramaAi_bot
# Public channel destination. Use @username for a public channel or -100... numeric ID.
TELEGRAM_CHANNEL_ID=@your_channel_username
TELEGRAM_CHANNEL_URL=https://t.me/your_channel_username
# Open the bot and send /myid, then paste your numeric Telegram user ID here.
ADMIN_TELEGRAM_ID=
# Can be the same private admin chat ID. Used as private media storage by the website.
TELEGRAM_STORAGE_CHAT_ID=
PUBLIC_BASE_URL=https://idramaai.onrender.com

# Bakong KHQR receiver
BAKONG_ACCOUNT_ID=
BAKONG_MERCHANT_NAME=iDramaAi
BAKONG_STORE_LABEL=iDramaAi
BAKONG_MERCHANT_CITY=PHNOM PENH
BAKONG_MOBILE_NUMBER=

# Bakong Open API
BAKONG_API_BASE_URL=https://api-bakong.nbc.gov.kh
BAKONG_TOKEN=
# true = TEST MODE (no real payment / free test unlock)
# false = real Bakong KHQR payment
BAKONG_TEST_MODE=false

# Security
# Use a long random value so paid Watch links remain valid across restarts.
ACCESS_TOKEN_SECRET=
# Password for /admin.html
ADMIN_PASSWORD=

# Save story metadata from Web Admin to GitHub
GITHUB_TOKEN=
GITHUB_REPO=lensbykai-bit/iDramame
GITHUB_BRANCH=main

# Render sets PORT automatically
PORT=3000
